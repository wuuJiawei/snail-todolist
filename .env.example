# SnailTask Configuration

# Backend API URL (required for online mode)
VITE_API_BASE_URL=http://localhost:8080

# Storage Mode Configuration
# Set to 'offline' for local-only mode using IndexedDB (no backend required)
# Set to 'online' for cloud mode using custom backend (default)
VITE_STORAGE_MODE=online

# Example configurations:
# 
# Local development:
#   VITE_API_BASE_URL=http://localhost:8080
#   VITE_STORAGE_MODE=online
#
# Production:
#   VITE_API_BASE_URL=https://api.your-domain.com
#   VITE_STORAGE_MODE=online
#
# Offline mode (no backend required):
#   VITE_STORAGE_MODE=offline

# Notes:
# - If VITE_STORAGE_MODE=offline, VITE_API_BASE_URL is not required
# - All data in offline mode is stored in browser's IndexedDB
# - Online mode requires a running SnailTask backend server
